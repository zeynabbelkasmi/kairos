# Copier ce fichier en .env
# Ollama Cloud : cle sur https://ollama.com/settings/keys
OLLAMA_API_KEY=colle_ta_cle_ici
LLM_MODEL=gpt-oss:120b
# Ou Gemini : GEMINI_API_KEY=... (et retirer OLLAMA_API_KEY)
# Lieux : sans cle, Kairos utilise la recherche web de Google Maps (non officielle, pour prototyper).
# PLACES_PROVIDER=auto (defaut : API officielle si une cle est presente, sinon Maps) | google_places | maps
PLACES_PROVIDER=auto
# Google Places API (New) - key restricted to Places API, kept server-side
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MIN_RATING=4.2
GOOGLE_PLACES_MIN_REVIEWS=10

# Film suggestion (IMDb, no key) when the request mentions a film
IMDB_MIN_RATING=7.0
IMDB_MIN_VOTES=25000
